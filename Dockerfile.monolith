FROM node:20-bookworm-slim AS frontend-builder

WORKDIR /workspace

COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci

COPY frontend ./frontend
RUN cd frontend && npm run build


FROM python:3.12-slim AS builder

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-group dev --no-group ingestion --no-group eval

COPY backend /app/backend
COPY data /app/data
COPY --from=frontend-builder /workspace/frontend/dist /app/frontend/dist


FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/backend /app/backend
COPY --from=builder /app/data /app/data
COPY --from=builder /app/frontend/dist /app/frontend/dist

CMD ["sh", "-c", "/app/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
