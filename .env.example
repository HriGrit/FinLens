OPENROUTER_API_KEY=sk-or-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000
QDRANT_URL=http://localhost:6333
TEST_QDRANT_COLLECTION=finlens_chunks_test
OPENROUTER_TEST_MODEL=openrouter/stepfun/step-3.5-flash:free
TEST_DOC_PATH=3M_2022_10K_10.pdf
QDRANT_COLLECTION=finlens_chunks_dev

# Compose/runtime defaults
VITE_API_PROXY_TARGET=http://backend:8000
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse
NEXTAUTH_SECRET=change-me-in-production-secret-32chars
NEXTAUTH_URL=http://localhost:3000
SALT=change-me-in-production-salt-32ch
ENCRYPTION_KEY=change-me-in-production-64-hex-characters
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

# Optional image overrides (pin to exact tags/digests as needed)
FRONTEND_IMAGE=finops-frontend-dev:local
QDRANT_IMAGE=qdrant/qdrant:latest
POSTGRES_IMAGE=postgres:15
LANGFUSE_IMAGE=langfuse/langfuse:2
